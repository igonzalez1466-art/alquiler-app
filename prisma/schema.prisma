generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  image                 String?
  passwordHash          String?
  emailVerified         DateTime?
  verificationCode      String?
  verificationExpiresAt DateTime?
  phone                    String?   @unique
  phoneVerifiedAt          DateTime?
  phoneVerificationTarget  String?
  phoneVerificationSentAt  DateTime?
  preferredInpostPointCode    String?
  preferredInpostPointAddress String?

  // Stripe Connect account del usuario cuando actúa como owner.
  stripeAccountId String? @unique

  bookingRestrictedAt DateTime?
  bookingRestrictionReason String?
  role Role @default(USER)

  accounts            Account[]
  ownedBookings       Booking[]      @relation("BookingOwner")
  bookings            Booking[]      @relation("BookingRenter")
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  listings            Listing[]
  messages            Message[]
  reviewsReceived     Review[]       @relation("UserReviewsReceived")
  reviewsAuthored     Review[]       @relation("UserReviewsAuthored")
  openedIncidents Incident[] @relation("IncidentOpenedBy")
  receivedIncidents Incident[] @relation("IncidentAgainst")
  incidentEvidence IncidentEvidence[]
  sessions            Session[]
}

model Listing {
  id          String       @id @default(cuid())
  title       String
  description String?
  minimumRentalDays Int @default(3)
  pricePerDay Int
  city        String?
  createdAt   DateTime     @default(now())
  userId      String
  estado      Estado       @default(USADO)
  fianza      Int?
  metodoEnvio MetodoEnvio  @default(RECOGIDA_LOCAL)
  marca       String?
  lat         Float?
  lng         Float?
  available   Boolean      @default(true)
  country     String?
  postalCode  String?
  color       Color?
  garmentType GarmentType?
  accessoryType String?
  otherGarmentType String?
  otherAccessoryType String?
  otherSport String?
  gender      Gender?
  sport       String?
  pregnancy   Boolean @default(false)
  materials   Json?
  size        String?

  bookings      Booking[]
  conversations Conversation[]
  images        Image[]
  user          User           @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([city])
  @@index([marca])
  @@index([lat, lng])
  @@index([postalCode])
  @@index([country])
  @@index([gender])
  @@index([sport])
  @@index([pregnancy])
  @@index([size])
  @@index([color])
  @@index([garmentType])
  @@index([accessoryType])
}

model Image {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  listingId String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id               String                   @id @default(cuid())
  listingId        String
  buyerId          String
  sellerId         String
  createdAt        DateTime                 @default(now())
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  status           ConversationStatus       @default(OPEN)
  closedAt         DateTime?
  closedReason     ConversationCloseReason?

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  listing  Listing   @relation(fields: [listingId], references: [id])
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
}

model SettlementOperation {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  kind String
  params Json
  attempt Int @default(1)
  status String @default("READY")
  startedAt DateTime?
  stripeId String? @unique
  amount Int?
  lastErrorCode String?
  @@unique([bookingId, kind])
}

model Booking {
  incidents Incident[]
  rentSettlement Json?
  rentRefundedCents Int @default(0)
  reviewInvitationsEnabled Boolean @default(true)
  reviewInvitations ReviewInvitation[]
  depositClaim Json?
  settlementDecision Json?
  settlementCompletedAt DateTime?
  settlementLegacyReview Boolean @default(false)
  settlementOperations SettlementOperation[]
  id            String @id @default(cuid())
  bookingNumber Int    @unique @default(autoincrement())

  listingId String
  renterId  String
  ownerId   String

  listing Listing @relation(fields: [listingId], references: [id])
  owner   User    @relation("BookingOwner", fields: [ownerId], references: [id])
  renter  User    @relation("BookingRenter", fields: [renterId], references: [id])

  evidencePhotos BookingEvidencePhoto[]
  reviews Review[]

  startDate DateTime
  endDate   DateTime
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())

  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  paymentRef    String?
  paymentDueAt  DateTime?
  cancelledAt   DateTime?
  renterCancellation Json?

  // ==========================================================
  // SNAPSHOT ECONÓMICO DE LA RESERVA
  // ==========================================================

  // Importe del alquiler utilizado por el flujo de pago.
  amountCents Int?

  // Precio por día congelado al crear la reserva.
  pricePerDayCents Int?

  // Importe total del alquiler sin incluir la kaucja.
  rentAmountCents Int?

  // Comisión de MojaSzafa expresada en basis points.
  // 1500 = 15.00 %
  platformFeeRate Int?

  // Importe de la comisión de MojaSzafa.
  platformFeeCents Int?

  // Importe neto del alquiler que corresponde al owner.
  // rentAmountCents - platformFeeCents
  ownerPayoutCents Int?

  // Kaucja congelada para esta reserva.
  // La kaucja NO está sujeta a comisión.
  depositCents Int?

  // ==========================================================
  // STRIPE CONNECT / TRANSFERENCIAS AL OWNER
  // ==========================================================

  // Transferencia Stripe del alquiler neto al owner.
  // Este importe ya tiene descontada la comisión de MojaSzafa.
  ownerTransferId    String?   @unique
  ownerTransferCents Int?
  ownerTransferredAt DateTime?

  // Transferencia Stripe de la parte retenida de la kaucja
  // que corresponde al owner como compensación.
  // Esta cantidad NO tiene comisión de MojaSzafa.
  depositTransferId       String?   @unique
  depositTransferredCents Int?
  depositTransferredAt    DateTime?

  // ==========================================================
  // Kaucja / depósito
  // ==========================================================

  depositPaymentIntentId     String?
  depositChargeId            String?
  depositRefundId            String?
  depositStatus              DepositStatus @default(NONE)
  depositPaidAt              DateTime?
  depositRefundedAt          DateTime?
  depositRefundedCents       Int?
  depositRetainedCents       Int?
  depositReleaseAt           DateTime?
  depositLastError           String?
  depositDecisionAt          DateTime?
  depositDecisionById        String?
  depositRetentionReason     String?
  depositRetentionReasonCode String?

  paidAt     DateTime?
  refundedAt DateTime?

  // ==========================================================
  // Envío
  // ==========================================================

  shippingStatus ShippingStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  deliveryInpostPointCode    String?
  deliveryInpostPointAddress String?

  // ==========================================================
  // Confirmación de entrega
  // ==========================================================

  deliveryConfirmationStatus DeliveryConfirmationStatus @default(NOT_REQUESTED)
  deliveryConfirmedAt        DateTime?
  deliveryConfirmedBy        DeliveryConfirmedBy?
  deliveryConfirmBy          DateTime?
  deliveryIssue              Json?

  // ==========================================================
  // Devolución
  // ==========================================================

  returnStatus         ShippingStatus @default(PENDING)
  returnCarrier        String?
  returnTrackingNumber String?
  returnShippedAt      DateTime?
  returnDeliveredAt    DateTime?
  returnInpostPointCode    String?
  returnInpostPointAddress String?

  // ==========================================================
  // Confirmación de devolución
  // ==========================================================

  returnConfirmationStatus ReturnConfirmationStatus @default(NOT_REQUESTED)
  returnConfirmedAt        DateTime?
  returnConfirmedBy        ReturnConfirmedBy?
  returnConfirmBy          DateTime?
  returnIssue              Json?

  // ==========================================================
  // Daños
  // ==========================================================

  damageClaimStatus DamageClaimStatus @default(NONE)
  damageClaimBy     DateTime?

  @@index([listingId])
  @@index([renterId])
  @@index([ownerId])
  @@index([paymentStatus])
  @@index([paymentDueAt])
  @@index([depositStatus])
  @@index([depositReleaseAt])
  @@index([shippingStatus])
  @@index([returnStatus])
  @@index([carrier, trackingNumber])
  @@index([returnCarrier, returnTrackingNumber])
  @@index([deliveryConfirmationStatus, deliveryConfirmBy])
  @@index([returnConfirmationStatus, returnConfirmBy])
  @@index([damageClaimStatus, damageClaimBy])
}

/// Append-only evidence: the database checks the uploader, sets the time and rejects updates.
model BookingEvidencePhoto {
  id         String               @id @default(cuid())
  bookingId  String
  uploaderId String
  stage      BookingEvidenceStage
  slot       Int
  mimeType   String
  data       Bytes                @db.ByteA
  createdAt  DateTime             @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, stage, createdAt])
  @@unique([bookingId, stage, uploaderId, slot])
}

enum BookingEvidenceStage {
  DELIVERY
  RETURN
}

model Review {
  id         String     @id @default(cuid())
  bookingId  String
  reviewerId String
  revieweeId String
  role       ReviewRole
  rating     Int
  comment    String?
  createdAt  DateTime   @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewee User    @relation("UserReviewsReceived", fields: [revieweeId], references: [id])
  reviewer User    @relation("UserReviewsAuthored", fields: [reviewerId], references: [id])

  @@unique([bookingId, reviewerId, revieweeId])
  @@index([revieweeId])
}

enum Role {
  USER
  ADMIN
}

enum Estado {
  NUEVO
  COMO_NUEVO
  USADO
  MUY_USADO
}

enum MetodoEnvio {
  RECOGIDA_LOCAL
  ENVIO_CORREOS
  MENSAJERIA
  OTRO
}

enum Gender {
  WOMAN
  MAN
  UNISEX
  KIDS
}

enum GarmentType {
  ABRIGO
  CHAQUETA
  MARYNARKA
  CAMISA
  BLUSA
  VESTIDO
  PANTALON
  FALDA
  TRAJE
  SUDADERA
  JERSEY
  MONO
  ACCESORIO
  OTRO
  ZAPATO
}

enum Color {
  CZARNY
  BIALY
  SZARY
  BEZOWY
  BRAZOWY
  CZERWONY
  ROZOWY
  POMARANCZOWY
  ZOLTY
  ZIELONY
  NIEBIESKI
  GRANATOWY
  FIOLETOWY
  ZLOTY
  SREBRNY
  WIELOKOLOROWY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  AWAITING_PAYMENT
  PAID
  CANCELLED
}

enum ReviewRole {
  OWNER
  RENTER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  BIZUM
  CASH
  OTHER
}

enum ShippingStatus {
  NOT_REQUIRED
  PENDING
  READY
  SHIPPED
  DELIVERED
  LOST
  CANCELLED
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum ConversationCloseReason {
  BOOKING_CANCELLED_BY_OWNER
  LISTING_UNAVAILABLE
  OTHER
}

enum DepositStatus {
  NONE
  PENDING
  PAID
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
  RETAINED
  FAILED
}

enum DepositRetentionReasonCode {
  DAMAGE
  STAINING
  MISSING_ITEM
  LATE_RETURN
  CLEANING
  OTHER
}

enum DeliveryConfirmationStatus {
  NOT_REQUESTED
  AWAITING_CONFIRMATION
  CONFIRMED
  DISPUTED
  AUTO_CONFIRMED
}

enum DeliveryConfirmedBy {
  RENTER
  SYSTEM
}

enum ReturnConfirmationStatus {
  NOT_REQUESTED
  AWAITING_CONFIRMATION
  CONFIRMED
  DISPUTED
  AUTO_CONFIRMED
}

enum ReturnConfirmedBy {
  OWNER
  SYSTEM
}

enum DamageClaimStatus {
  NONE
  OPEN
  CLAIMED
  RESOLVED
}

model ReviewInvitation {
  bookingId String
  recipientId String
  status String @default("PENDING")
  attempts Int @default(0)
  attemptedAt DateTime?
  sentAt DateTime?
  nextAttemptAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@id([bookingId, recipientId])
  @@index([status, nextAttemptAt])
}


enum IncidentStage {
  DELIVERY
  RETURN
}
enum IncidentReason {
  NOT_SHIPPED
  NOT_RECEIVED
  NOT_AS_DESCRIBED
  DAMAGED_ON_ARRIVAL
  LATE_DELIVERY
  RETURN_NOT_RECEIVED
  DAMAGED_ON_RETURN
  LATE_RETURN
  NOT_RETURNED
  OTHER
}
enum IncidentStatus {
  OPEN
  AWAITING_OWNER
  AWAITING_RENTER
  AGREEMENT_REACHED
  ESCALATED
  RESOLVED
}
model Incident {
  id String @id @default(cuid())
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  openedById String
  openedBy User @relation("IncidentOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  againstUserId String
  againstUser User @relation("IncidentAgainst", fields: [againstUserId], references: [id], onDelete: Restrict)
  stage IncidentStage
  reason IncidentReason
  status IncidentStatus @default(OPEN)
  description String
  createdAt DateTime @default(now())
  responseDueAt DateTime?
  reportedDeliveryDate DateTime? @db.Date
  resolvedAt DateTime?
  resolution String?
  refundCents Int?
  proposedById String?
  proposedAt DateTime?
  acceptedAt DateTime?
  refundId String? @unique
  evidence IncidentEvidence[]
  notifications IncidentNotification[]
  @@unique([bookingId, stage])
  @@index([againstUserId, status])
  @@index([openedById, status])
}
model IncidentEvidence {
  id String @id @default(cuid())
  incidentId String
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  uploaderId String
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  text String
  createdAt DateTime @default(now())
  @@index([incidentId, createdAt])
}

model IncidentNotification {
  id String @id @default(cuid())
  incidentId String
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  recipientId String
  eventKey String @unique
  to String
  subject String
  text String
  html String
  createdAt DateTime @default(now())
  sentAt DateTime?
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  lastError String?
  @@index([sentAt, nextAttemptAt])
  @@index([incidentId, createdAt])
}